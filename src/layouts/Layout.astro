---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'T-Mobile Bill Splitter' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="T-Mobile bill calculator and splitter for Saket's account" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/tmobile-calculator/favicon.svg" />
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <slot />
  </body>
</html>
